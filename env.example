# General settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGEME!!!
DJANGO_ALLOWED_HOSTS=tu-dominio.com

# Nombre del negocio: título del panel /admin, del login (registration/login.html) y de los
# tickets impresos (venta/cierre de caja) — ver core.context_processors.nombre_negocio.
# PROJECT_NAME_HEADER: encabezado del /admin (más largo/descriptivo).
# PROJECT_NAME_TITLE: nombre corto — <title> del login y encabezado de tickets.
# Debería coincidir con VITE_BUSINESS_NAME del frontend (frontend/.env).
PROJECT_NAME_HEADER=SISTEMA DE GESTION TU NEGOCIO
PROJECT_NAME_TITLE=TU NEGOCIO
# Origen(es) https:// exactos del sitio, separados por coma. Requerido por
# Django >=4.0 para que no rechace los POST (login, admin) con CSRF 403.
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# Database
# En Dokploy: crea un recurso "Database > PostgreSQL" y pega su connection string acá.
DATABASE_URL=postgres://dbuser:dbpass@host:port/mydb
# SQLite
# DATABASE_URL=sqlite:///mydb.db

# Security! Better to use DNS for this task, but you can use redirect
DJANGO_SECURE_SSL_REDIRECT=False

# Cantidad de workers de gunicorn (opcional, default 3)
GUNICORN_WORKERS=3

# OAuth2 (Authorization Code + PKCE) para el frontend SPA — ver docs/modernizacion/DECISIONES.md
# DEC-002. Redirect URI(s) del frontend, separadas por coma. Usada por el management command
# `crear_aplicacion_oauth_spa`. En desarrollo (Vite) el default es http://localhost:5173/auth/callback.
OAUTH2_SPA_REDIRECT_URIS=https://tu-dominio.com/auth/callback
# Duración de tokens (segundos). Defaults: 1800 (30 min) access, 2592000 (30 días) refresh.
OAUTH2_ACCESS_TOKEN_EXPIRE_SECONDS=1800
OAUTH2_REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# CORS — el frontend vive en el mismo dominio que esta API en producción (DEC-009), por eso en
# producción normalmente no hace falta setear esto (dejalo vacío/sin usar). Sólo se necesita en
# desarrollo, donde Vite corre en otro puerto; el default ya cubre localhost:5173.
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
