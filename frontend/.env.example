# URL base de la API Django (sin barra final). En desarrollo, el manage.py runserver por defecto.
VITE_API_BASE_URL=http://localhost:8000

# Nombre del negocio: se muestra en el sidebar y en el <title> de la pestaña (ver index.html).
# Debería coincidir con PROJECT_NAME_TITLE del backend (.env raíz) para que admin/tickets y
# frontend muestren el mismo nombre.
VITE_BUSINESS_NAME=Tu Negocio

# client_id de la Application OAuth2 pública — lo imprime por consola:
#   python manage.py crear_aplicacion_oauth_spa
# (ver docs/modernizacion/API.md § OAuth2 en la raíz del repo)
VITE_OAUTH_CLIENT_ID=pegar-aca-el-client_id

# Debe coincidir EXACTO con una de las redirect URIs registradas en la Application
# (OAUTH2_SPA_REDIRECT_URIS del backend). Puerto 5173 = default de `npm run dev`.
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
